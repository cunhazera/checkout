# Copy to .env for local overrides: `cp .env.example .env`
# The dev/start/migrate/seed scripts load it via --env-file-if-exists; a missing
# .env is fine, and real environment variables always win over the file.

# Postgres (docker-compose maps the container's 5432 to 5433 on the host,
# so a system Postgres on the default port does not collide)
DATABASE_URL=postgres://checkout:checkout@localhost:5433/checkout

# API — bind to loopback only. ADR-002 removes the auth layer entirely, which is
# only sound while the totem's own browser is the sole client.
# Must match the totem's VITE_API_TARGET (packages/totem/vite.config.ts)
PORT=3210
HOST=127.0.0.1

# Session / order TTL (ADR-002, arch doc: 15 minutes)
ORDER_TTL_MINUTES=15

# Payment terminal driver: fake | http | stripe | sumup
#   fake = in-process, controlled by FAKE_TERMINAL_MODE below
#   http = calls a real gateway over HTTP; in dev that is packages/gateway
PAYMENT_DRIVER=fake
PAYMENT_GATEWAY_URL=http://127.0.0.1:3220
# Per-attempt timeout. Past this the outcome is unknown, never assumed failed.
PAYMENT_HTTP_TIMEOUT_MS=15000
PAYMENT_HTTP_RETRIES=2

# The payment resolver: finishes attempts a crash interrupted.
# Grace period keeps it from racing a live request; after MAX_ATTEMPTS it stops
# asking and leaves the attempt for a person.
PAYMENT_RESOLVE_INTERVAL_MS=30000
PAYMENT_RESOLVE_GRACE_MS=60000
PAYMENT_RESOLVE_MAX_ATTEMPTS=10
# Fake driver behaviour: approve | decline | timeout | timeout_then_approve
FAKE_TERMINAL_MODE=approve

# Payment unknown-state polling (ADR-003)
PAYMENT_POLL_INTERVAL_MS=2000
PAYMENT_POLL_TIMEOUT_MS=30000

# Database pool. The number that matters is
# instances x DB_POOL_MAX <= Postgres max_connections (default 100), minus
# headroom for admin and jobs. Past a handful of instances put PgBouncer in
# front rather than raising this.
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

